import numpy as np
from sklearn.linear_model import LogisticRegression

# 1) Deine Feature-Funktion (wie gehabt)
def compute_features(state: np.ndarray, action: float) -> np.ndarray:
    x, x_dot, theta, theta_dot = state
    f1 = max(0.0, abs(x) - 0.1) / 0.1
    f2 = max(0.0, abs(theta) - 0.2) / 0.2
    f3 = max(0.0, abs(theta_dot) - 1.0) / 1.0
    f4 = max(0.0, abs(action) - 0.9) / 0.9
    f5 = max(0.0, abs(x_dot) - 0.5) / 0.5
    return np.array([f1, f2, f3, f4, f5], dtype=np.float32)

# 2) Modell initialisieren (noch untrainiert)
model = LogisticRegression()

# 3) Platzhalter für Trainingsdaten (müssen vorher gesammelt werden)
#    X_train: Array der Form (N_samples, 5)
#    y_train: Array der Form (N_samples,), Werte 0 oder 1
