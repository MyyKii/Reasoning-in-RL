# y_train = np.array([0, 1, ...])

# 4) Training (einfacher Aufruf, sobald X_train und y_train gefüllt sind)
# model.fit(X_train, y_train)

# 5) Risiko-Vorhersage für neuen Zustand (funktioniert auch untrainiert, gibt aber Unsinn zurück)
def predict_risk(state: np.ndarray, action: float) -> float:
    phi = compute_features(state, action).reshape(1, -1)  # Form (1,5)
    # model.predict_proba liefert [[P(safe), P(risky)]]
    return model.predict_proba(phi)[0, 1]

